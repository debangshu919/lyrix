{
  "name": "lyrix",
  "version": "0.1.0",
  "description": "Open source lyrics translation platform",
  "keywords": [
    "music",
    "lyrics",
    "translation"
  ],
  "homepage": "https://github.com/debangshu919/lyrix#readme",
  "bugs": {
    "url": "https://github.com/debangshu919/lyrix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debangshu919/lyrix.git"
  },
  "license": "MIT",
  "author": "Debangshu Das",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/rewrite-esm-imports.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "biome format --write src tests examples",
    "format:check": "biome format src tests examples",
    "lint": "biome lint src tests examples",
    "check": "biome check --write src tests examples",
    "test": "pnpm build && node --test tests/unit/*.test.mjs tests/metadata.test.mjs tests/lyrics.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "lrclib-api": "^2.0.4",
    "musicbrainz-api": "^1.2.1",
    "openai": "^7.3.0"
  }
}
